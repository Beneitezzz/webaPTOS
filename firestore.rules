rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(res) {
      return isAuth() && res.data.ownerId == request.auth.uid;
    }

    // Fields a business owner can edit on their own listing
    function onlyOwnerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'type', 'address', 'phone', 'description', 'tags',
                  'certifications', 'socialLinks', 'openingHours',
                  'photoUrls', 'menuFileUrl', 'certFileUrls', 'lat', 'lng']);
    }

    // rating is recomputed by any authenticated user after a review write/delete
    function onlyRatingField() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
        && (request.resource.data.rating == null
            || (request.resource.data.rating is number
                && request.resource.data.rating >= 0
                && request.resource.data.rating <= 5));
    }

    match /businesses/{businessId} {
      allow read: if true;

      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAdmin()
        || (isOwner(resource) && onlyOwnerFields())
        || (isAuth() && onlyRatingField());

      allow delete: if isAdmin() || isOwner(resource);

      match /reviews/{userId} {
        allow read: if true;
        allow create, update: if isAuth() && request.auth.uid == userId;
        allow delete: if isAuth() && request.auth.uid == userId;
      }
    }

    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;

      // Prevent self-assigning the admin role on account creation
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.role != 'admin';

      // Users can update their own profile but cannot change their role
      allow update: if isAdmin()
        || (isAuth()
            && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      allow delete: if isAuth() && request.auth.uid == userId;

      match /favorites/{businessId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }
  }
}
