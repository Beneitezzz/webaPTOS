rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Businesses: anyone can read; only admins can write
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Reviews: anyone can read; logged-in users can write their own review
      match /reviews/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // User profiles: only the owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Favorites subcollection
      match /favorites/{businessId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
