rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /certificados/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menus/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /fotos/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
