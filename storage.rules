rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidMenu() {
      return request.resource.contentType.matches('image/(jpeg|png)|application/pdf')
        && request.resource.size <= 50 * 1024 * 1024;
    }

    function isValidCert() {
      return request.resource.contentType.matches('image/(jpeg|png)|application/pdf')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    match /fotos/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    match /menus/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isValidMenu();
      allow delete: if request.auth != null;
    }

    match /certificados/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isValidCert();
      allow delete: if request.auth != null;
    }
  }
}
